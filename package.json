{
  "name": "k-streaming",
  "version": "1.0.1",
  "description": "K - modern streaming UI with TMDB + VidKing, vanilla JS + Express, Android TV WebView.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite --host",
    "dev:server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "vercel-build": "node scripts/generate-sitemap.js && echo \"No build step required - static files in public/ are served directly\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.3.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "license": "AGPL-3.0-only"
}
